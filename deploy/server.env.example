ASTERION_LISTEN_ADDR=127.0.0.1:8080
ASTERION_DATABASE_URL=sqlite:///var/lib/asterion/asterion.db
ASTERION_WEB_DIR=/opt/asterion/current/web
# 可选：首次 SSH 接入。启用时填写中心可信发布产物、目标可达地址及允许部署的网段。
# ASTERION_SSH_DEPLOY_AGENT=/opt/asterion/current/bin/asterion-agent
# ASTERION_SSH_DEPLOY_CENTER_URL=https://<目标服务器可访问的中心域名>:<HTTPS端口>
# ASTERION_SSH_DEPLOY_NETWORKS=<允许部署的CIDR，多个用逗号分隔>
# ASTERION_SSH_DEPLOY_CA_FILE=<中心公开CA证书的绝对路径>
