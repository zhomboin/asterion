{
  "systemd_units": ["<允许操作的完整服务 Unit 名称>"],
  "docker": {
    "operator_socket": "/run/asterion-docker-operator/requests.sock",
    "targets": [
      {
        "engine_id": "<Docker Engine ID>",
        "container_ids": ["<64 位 Docker 容器 ID>"]
      }
    ]
  },
  "process": {
    "term": false,
    "kill": false
  },
  "commands": [
    {
      "name": "echo_value",
      "program": "/usr/bin/printf",
      "args": ["%s", { "parameter": "value" }],
      "parameters": {
        "value": { "type": "identifier", "max_length": 32 }
      },
      "timeout_seconds": 5
    }
  ],
  "accounts": {
    "operator_socket": "/run/asterion-account-operator/requests.sock",
    "usernames": ["<允许管理的普通用户名>"],
    "groups": ["<允许变更的普通补充组名>"]
  }
}
