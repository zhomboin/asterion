[Unit]
Description=Asterion allowlisted Docker operations gateway

[Service]
Type=simple
User=asterion-docker
Group=asterion-operators
SupplementaryGroups=docker
RuntimeDirectory=asterion-docker-operator
RuntimeDirectoryMode=0750
Environment=ASTERION_DOCKER_OPERATOR_SOCKET=/run/asterion-docker-operator/requests.sock
LoadCredential=operator.json:/etc/asterion-agent/docker-operator.json
Environment=ASTERION_DOCKER_OPERATOR_CONFIG_FILE=%d/operator.json
ExecStart=/opt/asterion-agent/current/bin/asterion-docker-operator
Restart=on-failure
RestartSec=3s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
