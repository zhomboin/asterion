[Unit]
Description=Asterion isolated terminal helper

[Service]
Type=simple
DynamicUser=yes
Group=asterion-terminal-access
RuntimeDirectory=asterion-terminal-helper
RuntimeDirectoryMode=0750
Environment=ASTERION_TERMINAL_ENABLED=1
Environment=ASTERION_TERMINAL_HELPER_SOCKET=/run/asterion-terminal-helper/requests.sock
ExecStart=/opt/asterion-agent/current/bin/asterion-terminal-helper
Restart=on-failure
RestartSec=3s
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectHome=yes
ProtectProc=invisible
ProtectSystem=strict
InaccessiblePaths=-/var/lib/asterion-agent -/etc/asterion-agent -/run/asterion-agent -/run/asterion-docker-operator -/run/asterion-account-operator

[Install]
WantedBy=multi-user.target
